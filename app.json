{
  "expo": {
    "name": "Social flex",
    "slug": "social-flex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/avatar.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/avatar.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2F4F7"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/avatar.png",
        "backgroundColor": "#F2F4F7"
      }
    },
    "web": {
      "favicon": "./assets/avatar.png"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
